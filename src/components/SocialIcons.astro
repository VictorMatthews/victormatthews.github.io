---
// Maps a semantic icon id (the `icon` field on `profile.socials`) to an inline
// SVG. Kept fully static on purpose: no icon-font, no runtime JS, so the site
// stays pure-static and fast. Unknown ids fall back to a generic link glyph.
interface Props {
  icon: string;
  size?: number;
}

const { icon, size = 20 } = Astro.props;

const ICONS: Record<string, string> = {
  github:
    '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.205-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-.105-.27.075-.27.225 0 .72.15 1.05.345 1.065.795 1.74 1.11 2.145 1.11.57 0 .825-.375.825-.825 0-.78-.015-1.425-.015-2.025-2.745.57-3.33-1.29-3.33-1.29-.45-1.14-.105-1.395-.105-1.395.3-.09.615.195.93.45 1.005.825 2.22.615 2.745.48.09-.36.33-.72.57-.975-1.98-.165-4.05-1.005-4.05-4.44 0-.975.195-1.815.525-2.55-.51-.27-1.05-1.365-.45-2.805 0 0 .84-.285 2.76 1.065.81-.225 1.65-.33 2.475-.33.825 0 1.65.105 2.475.33 1.92-1.35 2.76-1.065 2.76-1.065.6 1.44.06 2.535-.45 2.805.33.735.525 1.575.525 2.55 0 3.45-2.07 4.275-4.05 4.44.33.33.615.975.615 1.965 0 1.425-.015 2.565-.015 2.91 0 .315.225.69.825.57C20.565 21.795 24 17.31 24 12c0-6.63-5.37-12-12-12z"/>',
  linkedin:
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.477-.9 1.639-1.85 3.396-1.85 3.644 0 4.312 2.38 4.312 5.46v5.28zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>',
  facebook:
    '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.47v-3.47h3.755V9.347c0-3.68 2.183-5.746 5.51-5.746 1.629 0 3.301.289 3.301.289v3.636h-1.854c-1.822 0-2.38.901-2.38 1.819v2.145h4.012l-.613 3.47h-3.4v8.385C19.612 23.027 24 18.062 24 12.073z"/>',
  email:
    '<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>',
  // No clean public path for HackerRank, so use a tasteful "H in a rounded
  // square" mark (stroked to match the terminal aesthetic of the theme).
  hackerrank:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 8.5v7M15 8.5v7M9 12h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
};

// Generic "external link" fallback so a missing/typo'd icon id never renders blank.
const FALLBACK =
  '<path d="M10 13a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.07 0l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>';

const body = ICONS[icon] ?? FALLBACK;
---

<svg
  class="social-icons"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
